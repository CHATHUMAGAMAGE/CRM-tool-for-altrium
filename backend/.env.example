# ---------------------------------------------------------------------
# Core Django settings
# ---------------------------------------------------------------------

SECRET_KEY=replace-with-a-secure-secret-key
DEBUG=True

ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC


# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------

# Render production database connection string.
# Leave blank for local development.
DATABASE_URL=

DB_NAME=eleven_crm
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=127.0.0.1
DB_PORT=5432

DB_CONN_MAX_AGE=600


# ---------------------------------------------------------------------
# Frontend and browser access
# ---------------------------------------------------------------------

FRONTEND_URL=http://localhost:5173

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required when the frontend and API are deployed on different hostnames
# (for example, separate Render services). Production defaults already use
# these values; declaring them here makes the deployment contract explicit.
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=None


# ---------------------------------------------------------------------
# Password recovery and email
# ---------------------------------------------------------------------

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10

DEFAULT_FROM_EMAIL=no-reply@eleven.local

PASSWORD_RESET_TIMEOUT=3600


# ---------------------------------------------------------------------
# HTTPS security
# ---------------------------------------------------------------------

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Password-reset delivery provider:
# Use "django" locally and "brevo" on Render.
PASSWORD_RESET_EMAIL_PROVIDER=django

BREVO_API_KEY=
BREVO_SENDER_NAME=ELEVEN CRM
BREVO_SENDER_EMAIL=
BREVO_TIMEOUT_SECONDS=10
